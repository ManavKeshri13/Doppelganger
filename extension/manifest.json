{
  "manifest_version": 3,
  "name": "Project Doppelgänger",
  "version": "1.0.0",
  "description": "Offensive privacy engine — inject synthetic browsing noise to poison tracker profiles.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Doppelgänger"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
