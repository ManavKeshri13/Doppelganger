# ============================================================
# Project Doppelgänger – Environment Configuration
# ============================================================
# 1. Copy this file to `.env`  →  cp .env.example .env
# 2. Fill in your real values below
# 3. NEVER commit .env to source control
# ============================================================

# --- LLM Provider (Groq) ------------------------------------
# Get a free API key at https://console.groq.com/
# Model used: llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# --- Server -------------------------------------------------
# Port the local REST API listens on (Chrome extension expects 8000)
SERVER_PORT=8000

# --- Headless Browser ---------------------------------------
# Set to "true" to show the Chrome window during development/debugging
BROWSER_HEADLESS=true

# Number of search queries to execute per /trigger call
QUERIES_PER_SESSION=3
